# wat.sifu — the root of the Sifu-to-WAT compiler.
#
# This file is the self-hosted compiler. The driver
# (src/compiler/core.zig) loads it as the trie, then evaluates an input
# Sifu trie.
# 
# Each rule rewrites a Sifu form to its WAT, assembling the surrounding syntax
# with the `++` string operator. WAT tokens live inside string literals
# (i32.add etc.) so their `.`/`(`/`)` characters stay opaque data
# and are never parsed as Sifu.

x + y --> "(i32.add " ++ (x) ++ " " ++ (y) ++ ")"
x - y --> "(i32.sub " ++ (x) ++ " " ++ (y) ++ ")"

# Comparisons. Each yields an i32 boolean (0 or 1), as WAT has no bool type.
x == y --> "(i32.eq " ++ (x) ++ " " ++ (y) ++ ")"
x < y --> "(i32.lt_s " ++ (x) ++ " " ++ (y) ++ ")"
x > y --> "(i32.gt_s " ++ (x) ++ " " ++ (y) ++ ")"

# Conditional. Folded `if` form: the condition is nested as a child, so no
# explicit stack ordering is needed. Result type is i32 (the only type so far).
If c Then a Else b --> "(if (result i32) " ++ (c) ++ " (then " ++ (a) ++ ") (else " ++ (b) ++ "))"

# Catch-all: a bare term is an i32 constant. Defined last so the multi-term and
# infix rules above are matched first.
n --> "(i32.const " ++ n ++ ")"
