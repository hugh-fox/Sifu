Map fn () ->
Map fn (*head, *tail) --> fn (*head), Map fn (*tail)

# ===

Map F ()

# ---

()

# ===

Map F (1 (2))

# ---

1 (2)

# ===

Map F (1 (2), 3 4)

# ---

F 1 (2), Map F (3 4)

# ===

Map F (1 2, 3 4,)

# ---

F 1 2, F 3 4,

# ===

Map F (1 2, 3 4, 5 6)

# ---

F 1 2, F 3 4, Map F (5 6)

# ===

Map F (1 2, 3 4, 5 6,)

# ---

F 1 2, F 3 4, F 5 6,
